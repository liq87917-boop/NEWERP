# NEWERP environment variable template. Never place real credentials in this file.
ERP_ConnectionStrings__Default=Server=<sql-host>,<port>;Database=<database>;User Id=<user>;Password=<password>;TrustServerCertificate=<true-or-false>
ERP_Jwt__Key=<generate-a-random-secret-of-at-least-32-bytes>
ERP_Jwt__Issuer=ERP.Api
ERP_Jwt__Audience=ERP.Client
ERP_Oss__AccessKeyId=<oss-access-key-id>
ERP_Oss__AccessKeySecret=<oss-access-key-secret>
ERP_Oss__Bucket=<oss-bucket>
ERP_Oss__Endpoint=<oss-endpoint>
ERP_Environment=Development
