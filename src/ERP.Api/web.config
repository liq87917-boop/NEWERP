<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 部署配置模板
  说明：发布时 .NET SDK 会自动补全 processPath / arguments，其余自定义配置原样保留。
    1. AspNetCoreModuleV2 ：ASP.NET Core 8 托管模块（需在服务器安装 Hosting Bundle）
    2. hostingModel=inprocess ：进程内托管，性能最优
    3. stdoutLogEnabled=true ：启用启动日志，写入 .\logs\stdout_*.log，用于排查站点启动失败
                               （站点稳定后可改为 false，业务日志由 Serilog 写入 .\logs\erp-*.log）
    4. requestLimits ：放宽请求体上限至 50MB，满足商品图片批量上传
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ERP.Api.dll"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- 运行环境：生产环境读取 appsettings.Production.json，敏感配置由 ERP_ 前缀环境变量注入 -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 请求体上限 50MB（图片批量上传） -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
